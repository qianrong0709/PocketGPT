{
  "stage": "condition_pretrain",
  "conditions": ["properties", "fragment"],
  "fragment_representation": "raw-smiles-v1",
  "train_data": "../data/condition-pretrain-v2-raw/train.jsonl",
  "valid_data": "../data/condition-pretrain-v2-raw/valid.jsonl",
  "vocabulary": "../data/condition-pretrain-v2-raw/vocabulary.json",
  "output_dir": "../runs/condition-pretrain-v2-raw",
  "model": {
    "architecture_version": 2,
    "fragment_encoder": "transformer-v1",
    "fragment_layers": 2,
    "block_size": 256,
    "n_layer": 8,
    "n_head": 8,
    "n_embd": 256,
    "dropout": 0.1
  },
  "training": {
    "epochs": 10,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "warmup_steps": 1000,
    "condition_dropout": 0.35,
    "property_dropout": 0.2,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "save_every_steps": 500,
    "log_every_steps": 100,
    "seed": 42,
    "device": "cuda",
    "cpu_threads": 4
  }
}
