{
  "stage": "finetune",
  "conditions": "all",
  "split_group": "complex_id",
  "fragment_representation": "raw-smiles-v1",
  "allow_unverified_pocket_embeddings": true,
  "train_data": "../data/cached-complex-raw/train.jsonl",
  "valid_data": "../data/cached-complex-raw/valid.jsonl",
  "output_dir": "../runs/finetune-cached-complex-raw",
  "condition_init_checkpoint": "../runs/condition-pretrain-v2-raw/best.pt",
  "model": {
    "architecture_version": 2,
    "fragment_encoder": "transformer-v1",
    "fragment_layers": 2,
    "block_size": 256,
    "n_layer": 8,
    "n_head": 8,
    "n_embd": 256,
    "dropout": 0.1
  },
  "training": {
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "warmup_steps": 500,
    "condition_dropout": 0.35,
    "property_dropout": 0.2,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "save_every_steps": 500,
    "log_every_steps": 100,
    "seed": 42,
    "device": "cuda",
    "cpu_threads": 4
  }
}
